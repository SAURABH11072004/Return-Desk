# PostgreSQL connection string used by the app, migrations and the seed script.
# Local (docker compose):
DATABASE_URL=postgres://returndesk:returndesk@localhost:5433/returndesk
# Neon / hosted Postgres: use the connection string from your provider, with ?sslmode=require

# Only needed to run the integration tests (npm test). Must point at a disposable database:
# the tests wipe it.
TEST_DATABASE_URL=postgres://returndesk:returndesk@localhost:5433/returndesk_test
